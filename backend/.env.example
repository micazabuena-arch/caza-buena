PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=caza_buena

# JWT (generate a long random string for production)
JWT_SECRET=change-this-to-a-secure-random-string
# Without "Remember me" (session login)
JWT_SESSION_EXPIRES_IN=8h
# With "Remember me" checked
JWT_REMEMBER_EXPIRES_IN=30d
# Legacy fallback if JWT_REMEMBER_EXPIRES_IN is unset
JWT_EXPIRES_IN=30d

# Admin seed credentials (used on first DB setup)
ADMIN_EMAIL=admin@cazabuena.com
ADMIN_PASSWORD=Admin@12345
# Set to 1 on Render/Hostinger once to apply ADMIN_PASSWORD to an existing admin, then remove
ADMIN_SYNC_PASSWORD=

# Cloudinary (free plan)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP — Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mi.caza.buena@gmail.com
SMTP_PASS=
EMAIL_FROM=Caza Buena <mi.caza.buena@gmail.com>
# Optional: inbox for contact form alerts (defaults to SMTP_USER)
CONTACT_NOTIFY_EMAIL=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Shown in guest email footers (optional — defaults match seed data)
RESORT_ADDRESS=Sitio Inansuana, Brgy. Lucap, Alaminos, Pangasinan
RESORT_PHONE=(0915) 711 8212

# Optional: public logo URL (defaults to embedded frontend/public/logo.png)
# EMAIL_LOGO_URL=https://yoursite.com/logo.png
