```gitignore
# Dependencies
node_modules/
venv/
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.npm/
.yarn/

# Build outputs
dist/
build/
target/
coverage/
htmlcov/
*.out

# Environment variables
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Python specific
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
pip-log.txt
.tox/
.coverage

# JavaScript/Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled files
*.class
*.o
*.so
*.dll
*.exe
*.a
*.obj

# Archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```