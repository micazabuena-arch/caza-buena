{
  "name": "caza-buena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "node scripts/ensure-frontend-built.mjs",
    "start": "node server.js",
    "build": "npm install --prefix frontend --include=dev && npm run build --prefix frontend",
